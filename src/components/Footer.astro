 ---
const currentYear = new Date().getFullYear();

const footerColumns = [
  {
    title: "Tasas",
    links: [
      { href: "/", label: "Brecha cambiaria hoy" },
      { href: "/convertidor-divisas", label: "Convertidor de divisas" },
      { href: "/calculadora-precios", label: "Calculadora de precios" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/terminos-de-servicio", label: "Términos de servicio" },
      { href: "/politica-de-privacidad", label: "Privacidad" },
      { href: "/politica-de-cookies", label: "Cookies" },
      { href: "/descargo-de-responsabilidad", label: "Descargo" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__container">
    <!-- ============================================
         BLOQUE SUPERIOR: Marca + Columnas
         ============================================ -->
    <div class="site-footer__main">
      <!-- Marca -->
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label="Inicio - Tasas Venezuela">
          <span class="site-footer__logo-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="24" height="24" rx="6" fill="#FCD535"/>
              <path d="M6 15L10 10L13 13L18 7" stroke="#0B0E11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M14 7H18V11" stroke="#0B0E11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="site-footer__logo-text">
            Tasas<span class="site-footer__logo-accent">Venezuela</span>
          </span>
        </a>

        <p class="site-footer__description">
          Información actualizada sobre la brecha cambiaria y las tasas de
          cambio en Venezuela.
        </p>
      </div>

      <!-- Columnas de links -->
      <div class="site-footer__columns">
        {
          footerColumns.map((column) => (
            <div class="site-footer__column">
              <h3 class="site-footer__column-title">{column.title}</h3>
              <ul class="site-footer__list">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="site-footer__link">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ============================================
         DISCLAIMER
         ============================================ -->
    <div class="site-footer__disclaimer">
      <span class="site-footer__disclaimer-icon" aria-hidden="true">⚠️</span>
      <p class="site-footer__disclaimer-text">
        Los datos mostrados son de carácter informativo y provienen de fuentes
        públicas. No constituyen información oficial ni asesoría financiera.
      </p>
    </div>

    <!-- ============================================
         BLOQUE INFERIOR: Copyright + Links
         ============================================ -->
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        © {currentYear} Tasas Venezuela. Todos los derechos reservados.
      </p>
      <ul class="site-footer__bottom-links">
        <li><a href="/descargo-de-responsabilidad">Descargo</a></li>
        <li aria-hidden="true">·</li>
        <li><a href="/politica-de-privacidad">Privacidad</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* ============================================
     FOOTER — CONTENEDOR PRINCIPAL
     ============================================ */
  .site-footer {
    margin-top: 0;
    padding: 3rem 0 1.5rem;
    border-top: 1px solid #2B3139;
    background-color: #0B0E11;
    color: #EAECEF;
    position: relative;
  }

  /* Glow amarillo sutil arriba */
  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    max-width: 400px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #FCD535, transparent);
    opacity: 0.6;
    pointer-events: none;
  }

  .site-footer__container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ============================================
     BLOQUE SUPERIOR
     ============================================ */
  .site-footer__main {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #2B3139;
    margin-bottom: 1.5rem;
  }

  /* ============================================
     MARCA
     ============================================ */
  .site-footer__brand {
    max-width: 360px;
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: transform 200ms ease;
  }

  .site-footer__logo:hover {
    transform: translateY(-1px);
  }

  .site-footer__logo-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .site-footer__logo-icon svg {
    display: block;
  }

  .site-footer__logo-text {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: #EAECEF;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .site-footer__logo-accent {
    color: #FCD535;
    margin-left: 2px;
  }

  .site-footer__description {
    font-size: 0.875rem;
    color: #B7BDC6;
    line-height: 1.7;
    margin: 0;
  }

  /* ============================================
     COLUMNAS DE LINKS
     ============================================ */
  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .site-footer__column-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #EAECEF;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .site-footer__link {
    color: #B7BDC6;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 150ms ease;
    display: inline-block;
  }

  .site-footer__link:hover {
    color: #FCD535;
  }

  /* ============================================
     DISCLAIMER
     ============================================ */
  .site-footer__disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background-color: rgba(252, 213, 53, 0.06);
    border: 1px solid rgba(252, 213, 53, 0.15);
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .site-footer__disclaimer-icon {
    font-size: 1rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .site-footer__disclaimer-text {
    font-size: 0.8125rem;
    color: #B7BDC6;
    line-height: 1.6;
    margin: 0;
  }

  /* ============================================
     BLOQUE INFERIOR
     ============================================ */
  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 1px solid #2B3139;
  }

  .site-footer__copyright {
    font-size: 0.8125rem;
    color: #848E9C;
    margin: 0;
  }

  .site-footer__bottom-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: #848E9C;
  }

  .site-footer__bottom-links a {
    color: #848E9C;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .site-footer__bottom-links a:hover {
    color: #FCD535;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 900px) {
    .site-footer__main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .site-footer__brand {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 2rem 0 1rem;
    }

    .site-footer__container {
      padding: 0 1rem;
    }

    .site-footer__main {
      gap: 1.75rem;
      padding-bottom: 1.5rem;
    }

    .site-footer__columns {
      gap: 1.5rem;
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .site-footer__bottom-links {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 420px) {
    .site-footer__columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
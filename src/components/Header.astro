---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/convertidor-divisas", label: "Convertidor" },
  { href: "/calculadora-precios", label: "Calculadora" },
  { href: "/descargo-de-responsabilidad", label: "Descargo" },
];

const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(href + "/");
---

<nav class="navbar navbar-expand-lg site-header" aria-label="Navegación principal">
  <div class="container-app">
    <!-- Logo -->
    <a class="navbar-brand site-logo" href="/" aria-label="Inicio - Tasas Venezuela">
      <span class="site-logo__icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="24" height="24" rx="6" fill="#FCD535"/>
          <path d="M6 15L10 10L13 13L18 7" stroke="#0B0E11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M14 7H18V11" stroke="#0B0E11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="site-logo__text">
        Tasas<span class="site-logo__accent">Venezuela</span>
      </span>
    </a>

    <!-- Toggler mobile -->
    <button
      class="navbar-toggler site-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Abrir menú de navegación"
    >
      <span class="site-toggler__bar"></span>
      <span class="site-toggler__bar"></span>
      <span class="site-toggler__bar"></span>
    </button>

    <!-- Menú -->
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
        {
          navLinks.map((link) => (
            <li class="nav-item">
              <a
                href={link.href}
                class={`nav-link site-nav-link ${isActive(link.href) ? "is-active" : ""}`}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }

        <!-- CTA -->
        <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
          <a
            href="https://www.bybit.com/invite?ref=Y8MB0PP"
            class="btn btn-primary btn-sm site-cta"
            target="_blank"
            rel="noopener noreferrer"
          >
            Comprar USDT
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* ============================================
     HEADER BASE
     ============================================ */
  .site-header {
    padding: 0;
    background: rgba(11, 14, 17, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    transition: all var(--transition-base);
  }

  .site-header :global(.container-app) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: 64px;
    padding-top: var(--spacing-sm);
    padding-bottom: var(--spacing-sm);
  }

  /* ============================================
     LOGO
     ============================================ */
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    transition: transform var(--transition-base);
  }

  .site-logo:hover {
    transform: translateY(-1px);
  }

  .site-logo__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .site-logo__icon svg {
    display: block;
  }

  .site-logo__text {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .site-logo__accent {
    color: var(--color-accent-primary);
    margin-left: 2px;
  }

  /* ============================================
     TOGGLER MOBILE (custom hamburguesa)
     ============================================ */
  .site-toggler {
    display: none; /* ← oculto por defecto */
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: transparent !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
    margin-left: auto;
  }

  .site-toggler:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(252, 213, 53, 0.15);
  }

  .site-toggler:hover {
    border-color: var(--color-border-hover) !important;
    background: var(--color-bg-card-hover) !important;
  }

  .site-toggler__bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  /* Mostrar toggler solo en mobile/tablet */
  @media (max-width: 991.98px) {
    .site-toggler {
      display: inline-flex;
    }
  }

  /* ============================================
     NAV LINKS
     ============================================ */
  .site-nav-link {
    color: var(--color-text-secondary) !important;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: var(--spacing-xs) var(--spacing-md) !important;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    position: relative;
  }

  .site-nav-link:hover {
    color: var(--color-text-primary) !important;
    background: var(--color-bg-card-hover);
  }

  .site-nav-link.is-active {
    color: var(--color-text-primary) !important;
    background: var(--color-bg-card);
  }

  .site-nav-link.is-active::before {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 2px;
    background: var(--color-accent-primary);
    border-radius: 2px;
  }

  /* ============================================
     CTA
     ============================================ */
  .site-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    white-space: nowrap;
  }

  .site-cta svg {
    transition: transform var(--transition-fast);
  }

  .site-cta:hover svg {
    transform: translateX(2px);
  }

  /* ============================================
     MOBILE (<992px)
     ============================================ */
  @media (max-width: 991.98px) {
    .site-header :global(.container-app) {
      min-height: 56px;
    }

    .site-header :global(.navbar-collapse) {
      flex-basis: 100%;
      margin-top: var(--spacing-md);
      padding: var(--spacing-md) 0 var(--spacing-sm);
      border-top: 1px solid var(--color-border);
    }

    .site-header :global(.navbar-collapse:not(.show)) {
      display: none;
    }

    .site-nav-link {
      padding: var(--spacing-sm) var(--spacing-md) !important;
      width: 100%;
      display: block;
    }

    .site-nav-link.is-active::before {
      display: none;
    }

    .site-nav-link.is-active::after {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 20px;
      background: var(--color-accent-primary);
      border-radius: 2px;
    }

    .site-cta {
      width: 100%;
      justify-content: center;
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .site-logo__text {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .site-logo__text {
      display: none;
    }
  }
  /* Toggler → X cuando el menú está abierto */
.site-toggler[aria-expanded="true"] .site-toggler__bar:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.site-toggler[aria-expanded="true"] .site-toggler__bar:nth-child(2) {
  opacity: 0;
}

.site-toggler[aria-expanded="true"] .site-toggler__bar:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}
</style>
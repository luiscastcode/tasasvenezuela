---
import type { ExchangeRate } from "../utils/api";
import { formatBs, formatDate } from "../utils/api";

interface Props {
  rate: ExchangeRate;
  /** Opcional: cambio porcentual respecto al día anterior */
  variation?: number;
  /** Opcional: color de acento por fuente (BCV, USDT, EUR...) */
  accent?: string;
}

const {
  rate,
  variation = 0,
  accent = "var(--color-accent-primary)",
} = Astro.props;

const hasRate = rate.rate > 0;
const isUp = variation >= 0;
const badgeClass = isUp ? "badge-up" : "badge-down";
const flecha = isUp ? "▲" : "▼";
---

<article class="rate-card" style={`--card-accent: ${accent}`}>
  <!-- Header: icono + nombre + badge -->
  <header class="rate-card__header">
    <div class="rate-card__identity">
      <div class="rate-card__icon" aria-hidden="true">
        {rate.symbol}
      </div>
      <div class="rate-card__info">
        <h3 class="rate-card__name">{rate.name}</h3>
        <span class="rate-card__code">{rate.code}</span>
      </div>
    </div>

    {
      hasRate && variation !== 0 && (
        <span class={badgeClass}>
          {flecha} {Math.abs(variation).toFixed(2)}%
        </span>
      )
    }
  </header>

  <!-- Valor principal -->
  <div class="rate-card__value">
    {hasRate ? formatBs(rate.rate) : "No disponible"}
  </div>

  <!-- Footer: última actualización -->
  <footer class="rate-card__footer">
    <span class="rate-card__update">
      <svg
        class="rate-card__update-icon"
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      Actualizado {formatDate(rate.lastUpdate)}
    </span>
  </footer>
</article>

<style>
  /* ============================================
     CARD BASE
     ============================================ */
  .rate-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    transition: all var(--transition-base);
    overflow: hidden;
  }

  /* Línea de acento superior (visible siempre, sutil) */
  .rate-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--spacing-md);
    right: var(--spacing-md);
    height: 2px;
    background: var(--card-accent);
    border-radius: 0 0 4px 4px;
    opacity: 0.6;
    transition: opacity var(--transition-base);
  }

  .rate-card:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .rate-card:hover::before {
    opacity: 1;
  }

  /* ============================================
     HEADER
     ============================================ */
  .rate-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .rate-card__identity {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    min-width: 0;
    flex: 1;
  }

  .rate-card__icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
    font-weight: 700;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--card-accent);
    flex-shrink: 0;
    transition: all var(--transition-base);
    line-height: 1;
  }

  .rate-card:hover .rate-card__icon {
    border-color: var(--card-accent);
    background: var(--color-bg-elevated);
  }

  .rate-card__info {
    min-width: 0;
    flex: 1;
  }

  .rate-card__name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 2px;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rate-card__code {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  /* ============================================
     VALOR
     ============================================ */
  .rate-card__value {
    font-size: 1.625rem;
    font-weight: 800;
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  /* ============================================
     FOOTER
     ============================================ */
  .rate-card__footer {
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .rate-card__update {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .rate-card__update-icon {
    flex-shrink: 0;
    opacity: 0.7;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 640px) {
    .rate-card {
      padding: var(--spacing-sm);
      gap: var(--spacing-sm);
    }

    .rate-card__icon {
      width: 36px;
      height: 36px;
      font-size: 1rem;
    }

    .rate-card__value {
      font-size: 1.375rem;
    }
  }
</style>
 ---
import type { ExchangeRate } from "../utils/api";
import type { RateStats } from "../utils/statistics";
import { formatBs } from "../utils/api";

interface Props {
  rates: ExchangeRate[];
  stats: RateStats;
}

const { rates, stats } = Astro.props;
const periodOptions = [7, 15, 30];
const chartPayload = JSON.stringify(stats.histories);

const averageVolatility = Math.round(
  stats.variations.reduce((sum, variation) => sum + variation.volatility30, 0) /
    stats.variations.length,
);

function obtenerFechaCorta() {
  const fecha = new Date();
  const dia = String(fecha.getDate()).padStart(2, "0");
  const mes = String(fecha.getMonth() + 1).padStart(2, "0");
  const anio = fecha.getFullYear();
  return `${dia}/${mes}/${anio}`;
}

// Mapeo visual por fuente (icono + color de acento)
const fuenteMeta: Record<string, { icon: string; color: string }> = {
  USD: { icon: "🏛️", color: "var(--color-accent-secondary)" }, // BCV azul
  USDT: { icon: "₮", color: "var(--color-accent-primary)" },   // USDT amarillo
  EUR: { icon: "€", color: "var(--color-accent-success)" },    // Euro verde
};

// Filtramos las variaciones a mostrar
const variacionesFiltradas = stats.variations.filter((v) =>
  ["USD", "USDT", "EUR"].includes(v.code)
);

// Tendencia
const trendIsUp = stats.trendScore >= 0;
const trendInterpretacion =
  stats.trendLabel === "Estable"
    ? "Las tasas oscilan sin tendencia definida"
    : stats.trendLabel === "Alcista"
      ? "Subida general en las últimas semanas"
      : "Descenso general en las últimas semanas";
---

<section class="rates-section">
  <div class="container-app">
    <!-- Header de sección -->
    <header class="section-header">
      <div class="section-header__badge">
        <span class="live-dot"></span>
        Tasas actualizadas · {obtenerFechaCorta()}
      </div>
      <h2 class="section-title">Tasas de Cambio en Venezuela</h2>
      <p class="section-subtitle">
        Dólar BCV, USDT y Euro BCV con su variación respecto a la tasa anterior
      </p>
    </header>

    <!-- Grid unificado: 3 tasas (span 2) + 2 highlights (span 3) -->
    <div class="rates-layout">
      <!-- Fila 1: Cards de tasas -->
      {
        variacionesFiltradas.map((variation, index) => {
          const meta = fuenteMeta[variation.code] ?? {
            icon: "•",
            color: "var(--color-text-muted)",
          };
          const isUp = variation.variation >= 0;
          const badgeClass = isUp ? "badge-up" : "badge-down";
          const flecha = isUp ? "▲" : "▼";
          const isLast = index === variacionesFiltradas.length - 1;

          return (
            <article
              class={`tasa-card ${isLast ? "tasa-card--last" : ""}`}
              style={`--card-accent: ${meta.color}`}
            >
              <header class="tasa-card__header">
                <div class="tasa-card__label">
                  <span class="tasa-card__icon" aria-hidden="true">
                    {meta.icon}
                  </span>
                  {variation.name}
                </div>
                <span class={badgeClass}>
                  {flecha} {variation.formattedVariation}
                </span>
              </header>

              <div class="tasa-card__value">
                {formatBs(variation.currentRate)}
              </div>

              <div class="tasa-card__delta">
                {isUp ? "+" : ""}
                {formatBs(variation.currentRate - variation.previousRate)}
                <span class="tasa-card__delta-label">
                  vs. tasa anterior
                </span>
              </div>

              <hr class="tasa-card__divider" />

              <div class="tasa-card__stats">
                <div class="tasa-card__stat">
                  <span class="tasa-card__stat-label">Anterior</span>
                  <span class="tasa-card__stat-value">
                    {formatBs(variation.previousRate)}
                  </span>
                </div>
                <div class="tasa-card__stat">
                  <span class="tasa-card__stat-label">Mín. 30d</span>
                  <span class="tasa-card__stat-value">
                    {formatBs(variation.min30)}
                  </span>
                </div>
                <div class="tasa-card__stat">
                  <span class="tasa-card__stat-label">Máx. 30d</span>
                  <span class="tasa-card__stat-value">
                    {formatBs(variation.max30)}
                  </span>
                </div>
              </div>
            </article>
          );
        })
      }

      <!-- Fila 2: Brecha cambiaria (span 3) -->
      <article class="highlight-card highlight-card--brecha">
        <div class="highlight-card__eyebrow">
          <span class="highlight-card__dot highlight-card__dot--accent"></span>
          Diferencial cambiario
        </div>
        <h3 class="highlight-card__title">
          Brecha cambiaria USDT / Dólar BCV
        </h3>

        <div class="highlight-card__values">
          <div class="highlight-card__main-value">
            {formatBs(stats.spreadAmount)}
          </div>
          <span
            class={`badge-${stats.spreadAmount >= 0 ? "up" : "down"} highlight-card__badge`}
          >
            {stats.spreadPercent >= 0 ? "▲" : "▼"}
            {stats.spreadPercent >= 0 ? "+" : ""}
            {stats.spreadPercent.toFixed(2)}%
          </span>
        </div>

        <p class="highlight-card__text">
          Diferencia entre la tasa oficial del BCV y el precio del USDT en el
          mercado. Una brecha alta indica mayor presión sobre el bolívar.
        </p>

        <div class="highlight-card__bar">
          <div
            class="highlight-card__bar-fill"
            style={`width: ${Math.min(Math.abs(stats.spreadPercent), 100)}%`}
          ></div>
        </div>
      </article>

      <!-- Fila 2: Tendencia (span 3) -->
      <article class="highlight-card highlight-card--tendencia">
        <div class="highlight-card__eyebrow">
          <span class="highlight-card__dot highlight-card__dot--info"></span>
          Análisis 30 días
        </div>
        <h3 class="highlight-card__title">
          Tendencia general acumulada
        </h3>

        <div class="highlight-card__values">
          <div class="highlight-card__main-value">
            {stats.trendLabel}
          </div>
          <span
            class={`badge-${trendIsUp ? "up" : "down"} highlight-card__badge`}
          >
            {trendIsUp ? "▲" : "▼"}
            {trendIsUp ? "+" : ""}
            {stats.trendScore.toFixed(2)}%
          </span>
        </div>

        <p class="highlight-card__text">{trendInterpretacion}</p>

        <div class="highlight-card__meta">
          <span>Volatilidad promedio</span>
          <strong class="tabular-nums">{averageVolatility}%</strong>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* ============================================
     SECTION
     ============================================ */
  .rates-section {
    padding: var(--spacing-xl) 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .section-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 4px 12px;
    margin-bottom: var(--spacing-md);
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-xs);
  }

  .section-subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 640px;
    margin: 0 auto;
  }

  /* ============================================
     GRID UNIFICADO — 6 columnas base
     Fila 1: 3 tasas × span 2 = 6
     Fila 2: 2 highlights × span 3 = 6
     ============================================ */
  .rates-layout {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-2xl);
  }

  .rates-layout > .tasa-card {
    grid-column: span 2;
  }

  .rates-layout > .highlight-card {
    grid-column: span 3;
  }

  /* ============================================
     CARD DE TASA
     ============================================ */
  .tasa-card {
    position: relative;
    padding-top: calc(var(--spacing-md) + 2px);
  }

  .tasa-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--spacing-md);
    right: var(--spacing-md);
    height: 2px;
    background: var(--card-accent, var(--color-accent-primary));
    border-radius: 0 0 4px 4px;
    opacity: 0.7;
  }

  .tasa-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    font-size: 0.875rem;
    line-height: 1;
  }

  .tasa-card__delta {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tasa-card__delta-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .tasa-card__divider {
    height: 1px;
    background: var(--color-border);
    border: none;
    margin: var(--spacing-sm) 0 0;
  }

  .tasa-card__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-sm);
    margin-top: var(--spacing-sm);
  }

  .tasa-card__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tasa-card__stat-label {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .tasa-card__stat-value {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  /* ============================================
     HIGHLIGHT CARDS
     ============================================ */
  .highlight-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-lg);
    position: relative;
    overflow: hidden;
    transition: border-color var(--transition-base);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .highlight-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent-primary),
      transparent
    );
  }

  .highlight-card:hover {
    border-color: var(--color-border-hover);
  }

  .highlight-card__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .highlight-card__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text-muted);
  }

  .highlight-card__dot--accent {
    background: var(--color-accent-primary);
    box-shadow: 0 0 8px rgba(252, 213, 53, 0.5);
  }

  .highlight-card__dot--info {
    background: var(--color-accent-secondary);
    box-shadow: 0 0 8px rgba(41, 98, 255, 0.5);
  }

  .highlight-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .highlight-card__values {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-top: var(--spacing-xs);
  }

  .highlight-card__main-value {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .highlight-card__badge {
    font-size: 0.8125rem;
    padding: 4px 10px;
  }

  .highlight-card__text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .highlight-card__bar {
    margin-top: auto;
    padding-top: var(--spacing-md);
    height: 6px;
    background: var(--color-bg-secondary);
    border-radius: 999px;
    overflow: hidden;
  }

  .highlight-card__bar-fill {
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--color-accent-primary) 0%,
      var(--color-accent-primary-hover) 100%
    );
    border-radius: 999px;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .highlight-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .highlight-card__meta strong {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */

  /* Tablet (≤1024px):
     - Tasas: 2 en fila (span 3) + última ocupa toda la fila (span 6)
     - Highlights: 1 por fila (span 6) */
  @media (max-width: 1024px) {
    .rates-layout > .tasa-card {
      grid-column: span 3;
    }

    .rates-layout > .tasa-card--last {
      grid-column: span 6;
    }

    .rates-layout > .highlight-card {
      grid-column: span 6;
    }

    .highlight-card__main-value {
      font-size: 1.875rem;
    }
  }

  /* Mobile (≤640px): todo a 1 columna */
  @media (max-width: 640px) {
    .rates-layout > .tasa-card,
    .rates-layout > .tasa-card--last,
    .rates-layout > .highlight-card {
      grid-column: span 6;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .tasa-card__value {
      font-size: 1.5rem;
    }

    .highlight-card {
      padding: var(--spacing-md);
    }

    .highlight-card__main-value {
      font-size: 1.75rem;
    }
  }
</style>